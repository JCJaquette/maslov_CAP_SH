clear %update to github

%% Manually define parameters

Case_number = 3; 
% Case 1 : params.mu = 0.1; 
% Case 2 : params.mu = 0.1; 
% Case 3 : params.mu = 0.2;  

% load bndl mflds and pulse

% Parameters for the pulse validation
params.rho = .99; %This is delta_s in paper 3
params.pulse.order = 2^10; %cheb coeffs of pulse
params.Eu.order = 2^8; %cheb coeffs of Eu-
params.tol=4e-14;
params.bd_scale = .2;%This sets how close the pulse gets to the manifold when we cut it off
params.new = 1.01;%new=delta in the paper, nu in the code for pulse existence CAP


    %ODE Parameters
if Case_number == 1 || Case_number == 2 
    params.mu = 0.1; 
    params.scale = .3;
    params.order = 40;
else
    params.mu = 0.2; 
    params.scale = .3;
    params.order = 26;  
end
params.nu = 1.6;
params.mfld.order = params.order;
  
% Interval Arithmetic  
params.isIntval = 1;
if params.isIntval 
    params.mu = intval(num2str(params.mu));  
    params.nu = intval('1.6');
end

% Potential parameter for finding 
params.lambda = 0; 

%% Automatically define parameters

if Case_number == 2 
    params.xi = pi;
else
    params.xi = 0;
end

%% Bundle and Manifold Computation

    if Case_number == 1 || Case_number == 2 
        %data_str = "data_bndl_nu_1p6_mu_0p1";
        data_str = 'test';
    else
        data_str = "data_bndl_nu_1p6_mu_0p2";
    end

%% Pulse Computation

    if Case_number == 1
        %data_str = "data_pulse1_nu_1p6_mu_0p1";
        data_str = 'test2';
        params.Lbvp = 3.999999999999992;
    elseif Case_number == 2 
        data_str = "data_pulse2_nu_1p6_mu_0p1";
    else
        data_str = "data_pulse_nu_1p6_mu_0p2";
    end

    load(data_str)

%% Eu- Computation
params.Eu.order = 2^10;
disp('Computing Eu-')

params.del = 1.01;
% TODO: get this stuff manually, move inside a function vv
maxphi = max(abs(pulse4D.phi1),abs(pulse4D.phi2)); 
mani_error = mflds.unstable.r_min; %not quite i believe since in the fn we use doubles
ICerror = 2*pi/log(1/maxphi) * mani_error; %Error of manifold's tangent bundle, see eqn 7.11(get this formula in paper)
%              %fix^^                 ^^

[U_vp, U_1, params.nonzero] = chebInt(params,mflds,pulse4D); %This gets U_{\varphi'} and U_1
%fix notation in Z1 bound
% figure; 
% title('cheb coeff decay')
% subplot(2,2,1);       
% plot(log(abs(U_1(:,1))));        
% title('component 1');       
% subplot(2,2,2);         
% plot(log(abs(U_1(:,2))));         
% title('component 2');
% subplot(2,2,3);        
% plot(log(abs(U_1(:,3))));         
% title('component 3');
% subplot(2,2,4);        
% plot(log(abs(U_1(:,4))));         
% title('component 4');
% 
% varphicheb = pulse4D.a1;
% prod1 = chebstar2fft(varphicheb',U_1(:,1));
% prod2 = chebstar2fft(varphicheb',prod1);
% 
% prod1int = chebstar2fft(intval(1)*varphicheb',intval(1)*U_1(:,1));
% prod2int = chebstar2fft(prod1int,intval(1)*U_1(:,1));
% 
% figure
% title('\varphi a_1 coeffs')
% plot(log(abs(prod1)));
% figure
% title('\varphi^2 a_1 coeffs')
% plot(log(abs(prod2)))
% 
% figure
% title('\varphi a_1 intval coeffs')
% plot(log(abs(sup(prod1int))));
% figure
% title('\varphi^2 a_1 intval coeffs')
% plot(log(abs(sup(prod2int))))

pulse4D.r = 1.8e-11;
phi_cheb = pulse4D.a1(1:params.nonzero)';
tail = pulse4D.a1' - [phi_cheb;zeros(params.Eu.order-params.nonzero,1)];
tail_error = vectorDelta1norm(tail,1.01);

pulse_error = pulse4D.r + tail_error;

params.rho = max(pulse_error,ICerror); %See corollary 3.1

r = EuminusCAP(params,phi_cheb,U_1);